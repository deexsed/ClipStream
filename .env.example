# MySQL
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=clipstream
MYSQL_USER=clipstream
MYSQL_PASSWORD=changeme_secret
MYSQL_ROOT_PASSWORD=changeme_root

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Twitch API
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_REDIRECT_URI=http://localhost/auth/callback
# Периодический импорт клипов (Helix Get Clips). По умолчанию 5 мин; лимиты — https://dev.twitch.tv/docs/api/guide#twitch-rate-limits
CLIP_SYNC_INTERVAL_MINUTES=5
# Optional: comma-separated Twitch broadcaster user IDs for EventSub WebSocket
# Example: TWITCH_EVENTSUB_BROADCASTER_IDS=42316376,37402112
TWITCH_EVENTSUB_BROADCASTER_IDS=

# JWT
JWT_SECRET=your_jwt_secret_key_min_32_chars_long
JWT_EXPIRATION_HOURS=24

# Server
BACKEND_PORT=8080
FRONTEND_PORT=3000
VITE_TWITCH_PARENT=localhost
