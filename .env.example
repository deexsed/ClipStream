# Local Docker Compose. Generate secrets: pwsh deploy/init-local.ps1
# Credentials live in SECRETS_DIR, never in images or tracked configuration.
SECRETS_DIR=./temp/secrets
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=clipstream
MYSQL_USER=clipstream
MYSQL_POOL_SIZE=10
REDIS_HOST=redis
REDIS_PORT=6379
TWITCH_CLIENT_ID=
TWITCH_REDIRECT_URI=http://localhost/auth/callback
CLIP_SYNC_INTERVAL_MINUTES=1
# WebSocket subscriptions require an OAuth user previously signed in to this app.
# Twitch user ID (not ClipStream database ID); the worker resolves/refreshed token from shared DB.
TWITCH_EVENTSUB_USER_ID=
TWITCH_EVENTSUB_BROADCASTER_IDS=
JWT_EXPIRATION_HOURS=24
HTTP_WORKERS=4
HTTP_BIND=127.0.0.1
HTTP_PORT=80
# Public immutable asset origin/prefix, ending with /. Use a retained CDN for multi-host rolling releases.
ASSET_BASE_URL=/

# Comma-separated exact HTTPS hosts permitted for advertiser assets. Empty disables remote assets.
ADS_MEDIA_HOSTS=

# Built-in noncommercial documents are served at /legal. Fill operator details before public launch.
# Optional absolute HTTPS URLs replace the corresponding built-in document.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_ADDRESS=
LEGAL_PRIVACY_URL=
LEGAL_TERMS_URL=
LEGAL_CONSENT_URL=
LEGAL_COOKIES_URL=
LEGAL_OFFER_URL=
LEGAL_CONSENT_VERSION=2026-11-14
